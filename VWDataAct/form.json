{
    "elements": [
        {
            "type": "Select",
            "name": "SourceMode",
            "caption": "Datenquelle",
            "options": [
                {
                    "caption": "Ordner / Lokale ZIP-Datei",
                    "value": "file"
                },
                {
                    "caption": "Automatischer Download vom Portal (drivesomethinggreater.com)",
                    "value": "api"
                }
            ]
        },
        {
            "type": "ValidationTextBox",
            "name": "FilePath",
            "caption": "ZIP-Dateipfad oder Ordnerpfad (für Lokalen Modus)"
        },
        {
            "type": "ExpansionPanel",
            "caption": "VW EU Data Act Portal Zugangsdaten (für Portal Download)",
            "items": [
                {
                    "type": "Select",
                    "name": "PortalBrand",
                    "caption": "Marke",
                    "options": [
                        {
                            "caption": "Volkswagen",
                            "value": "Volkswagen"
                        },
                        {
                            "caption": "Audi",
                            "value": "Audi"
                        },
                        {
                            "caption": "Škoda",
                            "value": "Skoda"
                        },
                        {
                            "caption": "SEAT",
                            "value": "Seat"
                        },
                        {
                            "caption": "CUPRA",
                            "value": "Cupra"
                        }
                    ]
                },
                {
                    "type": "ValidationTextBox",
                    "name": "PortalUsername",
                    "caption": "E-Mail (VW ID / myAudi / Cupra / SEAT ID)"
                },
                {
                    "type": "PasswordTextBox",
                    "name": "PortalPassword",
                    "caption": "Passwort"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "PortalVIN",
                    "caption": "Fahrzeug-ID (VIN / FIN, leer = einziges Fahrzeug im Portal)"
                }
            ]
        },
        {
            "type": "NumberSpinner",
            "name": "PollInterval",
            "caption": "Import Intervall (Minuten, 0 = Manuell)",
            "minimum": 0,
            "maximum": 1440,
            "suffix": " min"
        },
        {
            "type": "ExpansionPanel",
            "caption": "Datenbereich Feature-Toggles",
            "items": [
                {
                    "type": "CheckBox",
                    "name": "EnableHVBattery",
                    "caption": "Hochvolt-Akku & PV-Laden aktivieren"
                },
                {
                    "type": "CheckBox",
                    "name": "Enable12VBordnetz",
                    "caption": "12V-Bordnetz & Akku-Diagnose aktivieren"
                },
                {
                    "type": "CheckBox",
                    "name": "EnableSecurity",
                    "caption": "Sicherheit & Fahrzeugstatus aktivieren"
                },
                {
                    "type": "CheckBox",
                    "name": "EnableTyrePressure",
                    "caption": "Reifendruck & Sensorik aktivieren"
                },
                {
                    "type": "CheckBox",
                    "name": "EnableClimatisation",
                    "caption": "Klima, Komfort & Verbraucher aktivieren"
                },
                {
                    "type": "CheckBox",
                    "name": "EnableService",
                    "caption": "Laufleistung, Wartung & Systemzustand aktivieren"
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Vom Portal Herunterladen & Importieren",
            "onClick": "VWDA_DownloadAndImport($id);"
        },
        {
            "type": "Button",
            "caption": "Portal-Datensätze neu einlesen (neueste 8)",
            "onClick": "VWDA_ResetPortalState($id); VWDA_DownloadAndImport($id);"
        },
        {
            "type": "Button",
            "caption": "Lokale Daten Importieren & Aktualisieren",
            "onClick": "VWDA_UpdateData($id);"
        },
        {
            "type": "Button",
            "caption": "Visualisierung Neu Rendern",
            "onClick": "VWDA_RenderTileVisualization($id);"
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "VW EU Data Act Telemetry Modul ist aktiv."
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "Dateipfad, Portal-Zugangsdaten, Marke oder VIN nicht angegeben."
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "Fehler beim Lesen, Entpacken oder Portal-Download des Telemetrie-ZIPs."
        },
        {
            "code": 203,
            "icon": "error",
            "caption": "Portal-Anmeldung (VW ID Login) fehlgeschlagen."
        },
        {
            "code": 204,
            "icon": "error",
            "caption": "Export gehört zu einer anderen VIN – Import verworfen."
        },
        {
            "code": 205,
            "icon": "error",
            "caption": "Im Portal ist kein Fahrzeug bzw. keine Datenanfrage eingerichtet."
        },
        {
            "code": 206,
            "icon": "error",
            "caption": "Unerwartete Antwort des Portals."
        }
    ]
}
